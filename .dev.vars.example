# 本地开发用（wrangler dev 会自动读取；复制成 .dev.vars 再填）
SESSION_SECRET=local-dev-secret-please-change
SETUP_TOKEN=local-setup-token

# 图片存储：auto | b2 | kv | r2
# 本地默认 KV（Miniflare 模拟，不碰外部服务）
IMAGE_STORAGE=kv

# Backblaze B2（S3 兼容，可选）。密钥只放这里或 wrangler secret，不要进仓库。
# 注意：本地填了这些，wrangler dev 会写到真实的 B2 桶。
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=your-bucket
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
